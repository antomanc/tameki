<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tameki" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tameki_surface</item>
    </style>
    <style name="Theme.Tameki.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tameki_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tameki</item>
    </style>
    <color name="tameki_surface">#FCF8F5</color>
    <color name="tameki_launcher_background">#1F6F5C</color>
</resources>
